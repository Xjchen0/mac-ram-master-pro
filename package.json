{
  "name": "mac-ram-cleaner-pro",
  "version": "1.0.2",
  "description": "Professional macOS RAM Cleaner with Apple-grade UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHANGGELY/mac-ram-master-pro.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.main.json && vite build",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit"
  },
  "build": {
    "appId": "com.antigravity.rammaster",
    "productName": "RAM Master",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "public/icon.png"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
